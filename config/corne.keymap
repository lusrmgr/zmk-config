#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip { chain-length = <27>; };

/ {
    combos {
        compatible = "zmk,combos";

        Paste {
            bindings = <&kp LG(V)>;
            key-positions = <29 28>;
            layers = <0>;
        };

        email {
            bindings = <&dri_email>;
            key-positions = <13 14>;
        };

        Copy {
            bindings = <&kp LG(C)>;
            key-positions = <28 27>;
            layers = <0>;
        };
    };

    macros {
        dri_email: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp A &kp U &kp D &kp E &kp T &kp AT &kp D &kp A &kp T &kp A &kp R &kp E &kp M &kp O &kp T &kp E &kp DOT &kp C &kp O &kp M>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W           &kp E        &kp R           &kp T               &kp Y              &kp U                       &kp I                   &kp O            &kp P     &kp BSPC
&kp LCTRL  &kp A  &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_GUI F  &mt LEFT_SHIFT G    &mt RIGHT_SHIFT H  &mt RIGHT_GUI J             &mt RCTRL K             &mt RIGHT_ALT L  &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X           &kp C        &kp V           &kp B               &kp N              &kp M                       &kp COMMA               &kp DOT          &kp FSLH  &mt RGUI ESC
                                  &kp LGUI     &kp TAB         &lt 1 SPACE         &lt 2 ENTER        &mt LC(LEFT_GUI) BACKSPACE  &mt RALT LG(LS(SPACE))
            >;
        };

        lower_layer {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB                         &kp N1        &kp N2           &kp N3          &kp N4            &kp N5        &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&kp LS(LA(LC(LG(UP_ARROW))))    &trans        &trans           &trans          &trans            &trans        &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LS(LA(LC(LG(DOWN_ARROW))))  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans    &trans    &trans    &trans     &trans  &trans
                                                               &kp LGUI        &mo 3             &kp SPACE     &kp RET   &sl 4     &kp RALT
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR        &kp PRCNT    &kp CARET  &kp AMPS        &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp DELETE
&kp LCTRL  &trans    &trans  &trans    &trans          &trans       &kp MINUS  &kp EQUAL       &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans          &trans       &kp UNDER  &kp PLUS        &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &studio_unlock  &kp SPACE    &kp RET    &studio_unlock  &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans          &trans  &trans           &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &mmv MOVE_LEFT  &trans  &mmv MOVE_RIGHT  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans          &trans  &trans           &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans          &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans   &trans   &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
